{
  "name": "dadabase",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --build",
    "lint": "eslint . && stylelint \"src/**/*.{css,vue}\" && prettier --check .",
    "format": "prettier --write . && eslint . --fix",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --project storybook --coverage",
    "test:components": "vitest run --project storybook",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test:coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:smoke": "vitest run --project smoke",
    "build:site": "npm run build && storybook build --quiet --output-dir dist/storybook"
  },
  "dependencies": {
    "@apollo/client": "^3.14.1",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/comic-neue": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/unifrakturmaguntia": "^5.3.0",
    "@unhead/vue": "^3.4.3",
    "@vue/apollo-composable": "^4.2.2",
    "apollo-link-rest": "^0.9.0",
    "graphql": "^16.15.0",
    "pinia": "^4.1.0",
    "qs": "^6.17.1",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@mdx-js/rollup": "^3.1.1",
    "@playwright/test": "^1.65.1",
    "@resvg/resvg-js": "^2.6.2",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-vitest": "^10.6.7",
    "@storybook/vue3-vite": "^10.6.7",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.10",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/browser": "^5.1.0",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.6.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^9.39.5",
    "eslint-plugin-storybook": "^10.6.7",
    "eslint-plugin-vue": "^10.12.1",
    "jiti": "^2.7.0",
    "jsdom": "^27.0.1",
    "msw": "^3.0.6",
    "postcss-html": "^1.8.1",
    "prettier": "^3.10.1",
    "rehype-slug": "^6.0.0",
    "satori": "^0.63.2",
    "storybook": "^10.6.7",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "5.9",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "msw": {
    "workerDirectory": [
      "public-e2e"
    ]
  }
}
