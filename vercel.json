{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:site",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/storybook",
      "destination": "/storybook/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|storybook/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/storybook/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
